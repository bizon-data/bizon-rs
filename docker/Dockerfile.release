# Release image from prebuilt binaries (built in rust:bookworm, so glibc matches Debian 12).
# Expects dist/<arch>/bizon-stream for each target platform, e.g. dist/amd64, dist/arm64.
FROM gcr.io/distroless/cc-debian12:debug-nonroot
ARG TARGETARCH
COPY --chmod=0755 dist/${TARGETARCH}/bizon-stream /usr/local/bin/bizon-stream
ENTRYPOINT ["/usr/local/bin/bizon-stream"]
